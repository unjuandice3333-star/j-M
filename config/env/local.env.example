# =============================================================================
# Plantilla de entorno LOCAL — J&M FASHION STORE (M26-T4)
# Solo contiene valores PÚBLICOS del stack local de Supabase (Docker). Las llaves y los secretos van VACÍOS:
# cópielos de `supabase status` (stack local) y del panel sandbox de Wompi. Nunca versione el archivo con valores.
#
# Uso:
#   Navegador (Vite):  copie las variables VITE_* a apps/web/.env.local   (ignorado por git)
#   Funciones Vercel:  exporte las variables de servidor al ejecutar `vercel dev` o las pruebas
#   Edge Function:     WOMPI_EVENTS_SECRET en supabase/functions/.env       (ignorado por git)
# Comprobación: `pnpm check:env` (guarda de build) y `node scripts/env/templates.mjs check` (esta plantilla).
# =============================================================================

# --- Cliente (navegador; públicas por diseño) --------------------------------
# Entorno de la fábrica: local | qa (Production queda fuera del alcance de la fábrica)
VITE_APP_ENV=local
# URL del stack local de Supabase (API gateway)
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Llave pública/anon del stack local: `supabase status` → "anon key" / "Publishable key". Nunca la de servicio.
VITE_SUPABASE_ANON_KEY=
# Llave pública de Wompi en modo sandbox (prefijo pub_test_), del panel sandbox de Wompi.
VITE_WOMPI_PUBLIC_KEY=
# Modo de Wompi; en local siempre sandbox.
VITE_WOMPI_ENV=sandbox

# --- Servidor (funciones de Vercel; nunca con prefijo VITE_) ------------------
# Entorno del servidor: local | qa | production. En local y qa solo se aceptan credenciales sandbox de Wompi.
APP_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
# Llave de servicio del stack local: `supabase status` → "service_role key" / "Secret key".
SUPABASE_SERVICE_ROLE_KEY=
# Las mismas credenciales sandbox de Wompi, en su versión de servidor (prefijos pub_test_, test_integrity_, test_events_).
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
