# M26-T2 — Entorno de build de la FÁBRICA para CI y agentes (perfil local).
# Valores públicos y ficticios: NO son credenciales. La URL apunta al stack local de Supabase (loopback) y las
# llaves son marcadores que nunca autentican contra nada. Los usa scripts/ci/build.sh; se declaran aquí de forma
# explícita (no son valores por defecto del código de la aplicación).
VITE_APP_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=ci-placeholder-public-anon-key
VITE_WOMPI_PUBLIC_KEY=pub_test_ci_placeholder
VITE_WOMPI_ENV=sandbox
