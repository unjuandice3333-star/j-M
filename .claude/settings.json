{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --all:*)",
      "Bash(git push --tags:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push * main:*)",
      "Bash(git push *:main:*)",
      "Bash(git push * refs/heads/main:*)",
      "Bash(git push *:refs/heads/main:*)",
      "Bash(git push origin HEAD:*)",
      "Bash(git -c * push:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * --delete*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * +*)",
      "Bash(git push * --no-verify*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(gh secret:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh repo edit:*)",
      "Bash(supabase link:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase secrets:*)",
      "Bash(supabase login:*)",
      "Bash(npx supabase link:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase functions deploy:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./supabase/.temp/**)"
    ],
    "allow": [
      "Bash(git push origin mission/m26-dev-qa-environments)",
      "Bash(git push -u origin mission/m26-dev-qa-environments)"
    ]
  }
}
