# =============================================================================
# Variables de entorno — J&M FASHION STORE (índice; SOLO NOMBRES, sin valores)
# Actualizado en M26-T4: las plantillas por entorno están en config/env/
#   config/env/local.env.example  → desarrollo local (valores públicos del stack local)
#   config/env/qa.env.example     → QA (solo nombres; el propietario define los valores)
# Production está fuera del alcance de la fábrica: sus valores solo los gestiona el propietario en Vercel/Supabase.
# Nunca versione un archivo de entorno con valores reales. Los nombres los exige el código (guardas T2/T3).
# =============================================================================

# --- Cliente (navegador; prefijo VITE_, públicas por diseño) ------------------
VITE_APP_ENV=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WOMPI_PUBLIC_KEY=
VITE_WOMPI_ENV=

# --- Servidor (funciones de Vercel y Edge; nunca con prefijo VITE_) -----------
APP_ENV=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
