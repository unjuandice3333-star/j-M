# Configuración de Variables de Entorno — J&M FASHION STORE
# MODA MASCULINA · COLOMBIA

# ==============================================================================
# 1. PUBLIC VARIABLES (FRONTEND / NAVEGADOR VITE)
# ==============================================================================
# URL del proyecto Supabase Cloud
VITE_SUPABASE_URL=

# Clave Anónima Pública de Supabase (Lectura restringida por RLS)
VITE_SUPABASE_ANON_KEY=

# Llave Pública de Wompi Colombia (Llave de producción o Sandbox)
# Ejemplo Sandbox: pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Ejemplo Producción: pub_prod_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_WOMPI_PUBLIC_KEY=pub_test_jm_fashion_store_colombia

# ID de Seguimiento Google Analytics 4 (Opcional)
VITE_GA4_TRACKING_ID=G-XXXXXXXXXX

# ID de Seguimiento Meta Pixel / Facebook (Opcional)
VITE_META_PIXEL_ID=123456789012345


# ==============================================================================
# 2. SERVER-ONLY SECRETS (DENO EDGE FUNCTIONS / POSTGRESQL / SUPABASE BACKEND)
# NUNCA INCLUIR EN CÓDIGO BUNDLE DE FRONTEND REACT/VITE
# ==============================================================================
# Clave con permisos de administración (Service Role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_service_role_privada

# Secreto de Integridad para firma de transacciones Wompi
# Ejemplo Sandbox: test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
# Ejemplo Producción: prod_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_jm_fashion_secret

# Secreto de Eventos para firma de comprobación del Webhook de Wompi
WOMPI_EVENTS_SECRET=test_events_jm_fashion_secret
