{
  "name": "jm-fashion-retail",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise ERP/POS monorepo for fashion retail J&M",
  "scripts": {
    "dev:web": "pnpm --filter @jm/web dev",
    "dev:mobile": "pnpm --filter @jm/mobile dev",
    "build": "pnpm --filter @jm/web build",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,md,sql}\"",
    "prepare": "husky",
    "check:env": "node scripts/env/check_env.mjs",
    "build:factory": "node scripts/env/check_env.mjs && pnpm --filter @jm/web build",
    "test:env": "node --test scripts/env/environments.test.mjs scripts/env/check_env.test.mjs scripts/env/runtime_config.test.mjs scripts/env/templates.test.mjs scripts/env/gen_local_env.test.mjs scripts/env/qa_config.test.mjs",
    "check:templates": "node scripts/env/templates.mjs check",
    "env:local": "bash scripts/env/gen_local_env.sh",
    "smoke:env-local": "bash scripts/env/smoke_local_env.sh",
    "check:qa": "node scripts/env/qa_config.mjs check",
    "qa:rehearse-reset": "bash scripts/qa/rehearse_reset_local.sh",
    "dev:qa": "node scripts/env/qa_build.mjs dev",
    "build:qa": "node scripts/env/qa_build.mjs build",
    "preview:qa": "node scripts/env/qa_build.mjs preview",
    "test:qa-build": "node --test --test-concurrency=1 scripts/env/qa_build.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.0.8"
}
