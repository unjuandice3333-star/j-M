{
  "name": "jm-fashion-retail",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise ERP/POS monorepo for fashion retail J&M",
  "scripts": {
    "dev:web": "pnpm --filter @jm/web dev",
    "dev:mobile": "pnpm --filter @jm/mobile dev",
    "build": "pnpm --filter @jm/web build",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,md,sql}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.0.8"
}
